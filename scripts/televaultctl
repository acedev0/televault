#!/usr/bin/env bash
set -Eeuo pipefail

SERVICE="televault.service"
APP_DIR="${TELEVAULT_INSTALL_ROOT:-/opt/televault}/app"
VENV="${TELEVAULT_INSTALL_ROOT:-/opt/televault}/.venv"
DATA_DIR="${TELEVAULT_DATA_DIR:-/var/lib/televault}"
SERVICE_USER="televault"

need_root() {
  if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
    printf 'Run this command with sudo.\n' >&2
    exit 1
  fi
}

usage() {
  cat <<'HELP'
TeleVault management

Usage: televaultctl <command>

  status       Show service status
  logs         Follow service logs
  restart      Restart TeleVault
  start        Start TeleVault
  stop         Stop TeleVault
  sync         Scan Telegram for new media now
  full-sync    Re-read the complete chat history
  doctor       Test configuration, database, and Telegram access
  configure    Repeat the interactive setup
  update       Install the latest release from GitHub
HELP
}

case "${1:-}" in
  status) systemctl status "$SERVICE" --no-pager ;;
  logs) journalctl -u "$SERVICE" -f --no-pager ;;
  restart) need_root; systemctl restart "$SERVICE"; systemctl status "$SERVICE" --no-pager ;;
  start) need_root; systemctl start "$SERVICE" ;;
  stop) need_root; systemctl stop "$SERVICE" ;;
  sync|full-sync)
    need_root
    systemctl stop "$SERVICE"
    trap 'systemctl start "$SERVICE" >/dev/null 2>&1 || true' EXIT
    scan_args=(scan)
    [[ "$1" == "full-sync" ]] && scan_args+=(--full)
    runuser -u "$SERVICE_USER" -- bash -c "cd '$APP_DIR' && '$VENV/bin/python' -m televault --data-dir '$DATA_DIR' ${scan_args[*]}"
    systemctl start "$SERVICE"
    trap - EXIT
    ;;
  doctor)
    need_root
    runuser -u "$SERVICE_USER" -- bash -c "cd '$APP_DIR' && '$VENV/bin/python' -m televault --data-dir '$DATA_DIR' doctor"
    ;;
  configure)
    need_root
    TELEVAULT_RECONFIGURE=1 bash "$APP_DIR/install.sh"
    ;;
  update)
    need_root
    TELEVAULT_SKIP_SETUP=1 bash "$APP_DIR/install.sh"
    ;;
  *) usage; [[ -n "${1:-}" ]] && exit 1 || exit 0 ;;
esac

